# /backend/.env.example — шаблон переменных окружения бэкенда (WordPress).
# Скопируйте в backend/.env и подставьте свои значения:
#   cp backend/.env.example backend/.env
# Реальные .env в git не попадают (.gitignore: /backend/.env).
#
# !Доступы к БД сюда НЕ вносятся: локальный DDEV берет их из
# wp-config-ddev.php (создается автоматически), на хостинге — из wp-config.php.
# Этот файл — для собственных переменных темы (PHP читает их через
# getenv()/$_ENV после загрузки .env).

# --- Отправка почты через PHPMailer (SMTP) ---
# PHPMailer входит в ядро WordPress (wp-includes/PHPMailer) и настраивается
# через хук phpmailer_init; SMTP-модуль темы будет читать эти переменные.
# Хост, порт и учетные данные дает ваш почтовый провайдер.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Шифрование соединения: tls (обычно для 587) или ssl (обычно для 465).
SMTP_SECURE="tls"
# Отображаемое имя отправителя в письмах.
SMTP_FROM_NAME=""
