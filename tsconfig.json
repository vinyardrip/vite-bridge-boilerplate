{
  /*!
   * =================================================================================================
   * Корневой tsconfig — типизация для всего монорепо, кроме пакета
   * packages/vite-plugin-smart-assets (у него свой tsconfig со strict:true).
   *
   * Содержит только проверку типов (noEmit) — бандлинг делает Vite/esbuild,
   * тесты запускает tsx. По мере миграции strict включается здесь (шаг 4)
   * и в пакетах.
   * =================================================================================================
   */
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],

    // Импорты внутри TS-кода проекта — с явным расширением .ts
    // (noEmit — бандлит Vite/esbuild, компиляции нет).
    "allowImportingTsExtensions": true,
    // Миграция завершена: строгие проверки во всем проекте.
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/src/*"],
      // workspace-пакет: типы берутся прямо из .ts-исходников (main пакета —
      // index.ts, у d.ts для него нет).
      "vite-plugin-smart-assets": ["./packages/vite-plugin-smart-assets/index.ts"],
      "vite-plugin-smart-assets/*": ["./packages/vite-plugin-smart-assets/src/*"]
    }
  },
  "include": [
    "frontend/src",
    "frontend/tests",
    "scripts",
    "*.ts",
    // Ambient-шимы svgo (глубокие импорты): исходники пакета попадают в
    // корневую программу через импорты vite.config.ts — декларации должны
    // быть частью программы.
    "packages/vite-plugin-smart-assets/src/types"
  ],
  "exclude": [
    "node_modules",
    // packages/ исключаем, КРОМЕ шимов svgo: exclude сильнее include, поэтому
    // указываем точечно (тесты пакета проверяются своим tsconfig).
    "packages/*/node_modules",
    "packages/*/test",
    "dist",
    "dist-wp",
    "backend",
    "playwright-report",
    "test-results",
    ".ck",
    ".dpx"
  ]
}
