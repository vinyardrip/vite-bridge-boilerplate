# =================================
# System & IDE Files
# =================================
.DS_Store
.idea/
.vscode/

# =================================
# Node / Monorepo Root
# =================================
# Папка с зависимостями, устанавливаемыми pnpm. Никогда не должна быть в Git.
/node_modules
# node_modules локальных пакетов монорепо (packages/*)
packages/*/node_modules
# Папка с результатом production-сборки. Будет создана Vite в корне проекта.
/dist
# Статическая сборка без AVIF для слабого хостинга (pnpm strip-avif:dist).
/dist-wp
# Локальные кеш-файлы для утилит оптимизации.
.tinypng-cache
.svgo-cache

# =================================
# DDEV & Backend
# =================================
# Локальная конфигурация и данные DDEV.
/backend/.ddev
# Ядро WordPress: ставится через `ddev wp core download`, в Git не отслеживается.
# В репозитории живут только исходники темы (wp-content/themes/my-theme)
# и собственные файлы проекта.
/backend/index.php
/backend/license.txt
/backend/readme.html
/backend/wp-*.php
/backend/xmlrpc.php
/backend/wp-admin/
/backend/wp-includes/
/backend/wp-content/index.php
# Штатные плагины ядра (akismet, hello.php) — тема и свои плагины не трогаем.
/backend/wp-content/plugins/*
!/backend/wp-content/plugins/.gitkeep
# Дистрибутивные темы ядра (twentytwentythree и т.д.) — отслеживаем только my-theme.
/backend/wp-content/themes/*
!/backend/wp-content/themes/my-theme
# Конфигурационный файл WP с секретными ключами (покрывается маской wp-*.php).
# Собранные фронтенд-ассеты темы (создается pnpm build:wp — плоская структура).
/backend/wp-content/themes/my-theme/assets/
# Загруженные пользователем медиафайлы.
/backend/wp-content/uploads
# Зависимости Composer.
/backend/vendor
# Файл с переменными окружения для бэкенда.
/backend/.env

# =================================
# Frontend
# =================================
# Файл с переменными окружения для фронтенда (например, ключи API).
/frontend/.env
# Сгенерированные при сборке AVIF/WebP-сиблинги для картинок из public/img
# (vite-plugin-image-optimize пишет их рядом с исходниками).
/frontend/public/img/*.webp
/frontend/public/img/*.avif
# Сжатые TinyPNG-копии (scripts/compress-images.ts) — артефакт, не исходник.
/frontend/src/assets/images-tiny/
# Sass-карта путей smart-assets — генерируется плагином на buildStart
# (frontend/src/scss/generated/_smart-assets-map.scss), артефакт, не исходник.
/frontend/src/scss/generated/
# Отчеты и артефакты прогонов Playwright.
/test-results
/playwright-report

# =================================
# Service & Local Files
# =================================
# Файлы, не относящиеся к проекту напрямую.
STATUS.md
# Файл для менеджера версий mise/asdf.
.tool-versions
# Context Keeper
.ck/*.bak
.ck/*.md.gz
.ck/state.json
# DPX: журналы сессий (создаются в каталоге запуска команд).
.dpx/
