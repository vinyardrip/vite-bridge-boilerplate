# =================================
# System & IDE Files
# =================================
.DS_Store
.idea/
.vscode/

# =================================
# Node / Monorepo Root
# =================================
# Папка с зависимостями, устанавливаемыми pnpm. Никогда не должна быть в Git.
/node_modules
# Папка с результатом production-сборки (static-режим).
/dist
# Локальные кеш-файлы для утилит оптимизации.
.tinypng-cache
.svgo-cache
.convert-images-cache.json
# Generated webp/avif images (created by scripts/convert-images.js — regenerated
# automatically during the build pipeline).
frontend/src/assets/**/*.webp
frontend/src/assets/**/*.avif

# =================================
# DDEV & Backend
# =================================
# Локальная конфигурация и данные DDEV.
/backend/.ddev
# Конфигурационный файл WP с секретными ключами.
/backend/wp-config.php
# Загруженные пользователем медиафайлы.
/backend/wp-content/uploads
# Зависимости Composer.
/backend/vendor
# Файл с переменными окружения для бэкенда.
/backend/.env

# =================================
# CMS Theme Build Output
# =================================
# WordPress / CMS theme build target. All contents are generated by pnpm build
# and must never be committed. The .gitkeep inside the directory is tracked
# to preserve the folder structure, but all generated files are ignored.
backend/wp-content/themes/*/
backend/wp-content/themes/*

# =================================
# Frontend
# =================================
# Файл с переменными окружения для фронтенда (например, ключи API).
/frontend/.env

# =================================
# Service & Local Files
# =================================
# Файлы, не относящиеся к проекту напрямую.
STATUS.md
# Файл для менеджера версий mise/asdf.
.tool-versions

# =================================
# Runtime & Temp Files
# =================================
*.log
*.pid

# =================================
# Test Artifacts
# =================================
test-results/
playwright-report/