# /frontend/.env.example — шаблон переменных окружения фронтенда.
# Скопируйте в frontend/.env и подставьте свои значения:
#   cp frontend/.env.example frontend/.env
# Реальные .env в git не попадают (.gitignore: /frontend/.env).

# API ключи сервиса TinyPNG — сжатие исходников перед сборкой
# (scripts/compress-images.js, шаг pnpm build).
# Можно указать несколько, разделив их запятыми: скрипт попробует их по очереди.
# Нет валидных ключей — сборка НЕ падает, только warning в логе.
# Получить ключ: https://tinypng.com/developers
TINYPNG_API_KEYS=""
