{% extends "layouts/_default.njk" %}

{% block content %}

  {% include "partials/_header.njk" %}

  <main class="main">
    {# ... основной контент страницы ... #}
    <div style="padding: 40px; text-align: center; font-family: sans-serif;">
      <h1>🚀 Nunjucks-архитектура работает!</h1>
    </div>

    {# Добавляем видео-компонент для теста #}
    <div style="max-width: 800px; margin: 40px auto;">
      {% include "components/_video.njk" %}
    </div>

    {# ДЕМО-СЕКЦИЯ КОМПОНЕНТОВ: используется интеграционными
       Playwright-тестами (модалки, аккордеон, форма) #}
    <div class="container" style="max-width: 800px; margin: 0 auto 40px; padding: 0 16px;">
      <h2>Демо компонентов</h2>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin: 16px 0 24px;">
        <button type="button" data-modal-trigger="thanks">Открыть окно «Спасибо»</button>
        <button type="button" data-modal-trigger="policy">Открыть «Политику»</button>
      </div>

      {% include "components/_accordion.njk" %}

      <div style="margin-top: 24px;">
        {% include "components/_form.njk" %}
      </div>
    </div>

  </main>

  {% include "partials/_footer.njk" %}

  {# ПОДКЛЮЧАЕМ КОМПОНЕНТ #}
  {% include "components/_scroll-to-top.njk" %}

  {# Оверлей модальных окон (общий контейнер для всех окон страницы) #}
  {% include "components/_modals.njk" %}

{% endblock %}