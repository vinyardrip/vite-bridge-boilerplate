{#
  Этот файл является библиотекой Nunjucks-макросов (аналог "миксинов" или "функций").
  Макросы - это переиспользуемые фрагменты кода для генерации HTML.

  ----------------------------------------------------------------------------------------------------
  КАК ИСПОЛЬЗОВАТЬ:
  ----------------------------------------------------------------------------------------------------

  1. Импортируйте этот файл в шаблоне, где хотите использовать макрос:
    {% import "../macros/_ui.njk" as ui %}

  2. Вызовите макрос по его имени через заданный псевдоним (`ui`):

    <!-- Простой вызов -->
    {{ ui.icon('phone') }}

    <!-- Вызов с дополнительным классом -->
    {{ ui.icon('arrow-right', 'button__icon') }}

    <!-- Кнопка и карточка (живые примеры — на /styleguide.html) -->
    {{ ui.button('Отправить', variant='primary') }}
    {% call ui.card(title='Заголовок', text='Текст') %}{{ ui.button('Подробнее') }}{% endcall %}
  ----------------------------------------------------------------------------------------------------
#}

{#
  Макрос для вставки SVG-иконки из автоматически генерируемого спрайта.

  @param {string} name - Имя (ID) иконки без префикса "icon-".
  @param {string} [class] - (Опционально) Дополнительный CSS-класс для тега <svg>.
#}
{% macro icon(name, class) %}
  <svg class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false">
    {#
    Путь относительный (base: './'): Vite поместит спрайт в dist/img/sprite.svg,
    страница в корне dist — './img/sprite.svg' работает и через file://.
  #}
    <use xlink:href="./img/sprite.svg#icon-{{ name }}"></use>
  </svg>
{% endmacro %}

{#
  Макрос кнопки. Если передан href — рендерит <a>, иначе <button>.
  Стили: components/_buttons.scss (.btn + модификаторы BEM).

  @param {string} text - Текст кнопки.
  @param {string} [href] - Если задан, кнопка становится ссылкой <a>.
  @param {string} [variant] - Вариант: 'primary' (умолчание) | 'secondary' | 'outline' | 'ghost'.
  @param {string} [size] - Размер: 'sm' | 'lg' (без модификатора — обычный).
  @param {string} [type] - Тип для <button> (умолчание 'button'; для отправки формы — 'submit').
  @param {string} [class] - Дополнительные CSS-классы.
  @param {boolean} [disabled] - Неактивное состояние (<button disabled> либо .is-disabled у ссылки).
#}
{% macro button(text, href, variant='primary', size, type='button', class, disabled=false) -%}
  {%- set size_class = '' -%}
  {%- if size -%}{% set size_class = ' btn--' ~ size %}{%- endif -%}
  {%- set extra_class = '' -%}
  {%- if class -%}{% set extra_class = ' ' ~ class %}{%- endif -%}
  {%- set btn_class = 'btn btn--' ~ variant ~ size_class ~ extra_class -%}
  {%- if href -%}
  <a class="{{ btn_class }}{% if disabled %} is-disabled{% endif %}" href="{{ href }}"{% if disabled %} aria-disabled="true"{% endif %}>{{ text }}</a>
  {%- else -%}
  <button class="{{ btn_class }}" type="{{ type }}"{% if disabled %} disabled{% endif %}>{{ text }}</button>
  {%- endif -%}
{%- endmacro %}

{#
  Макрос карточки. Заголовок и текст — параметрами, а содержимое футера
  (кнопки, ссылки) можно передать блоком {% call %} — оно попадет в .card__footer.
  Стили: components/_cards.scss.

  Пример:
    {% call ui.card(title='Консультация', text='Разберем вашу задачу') %}
      {{ ui.button('Записаться', href='#form') }}
    {% endcall %}

  @param {string} [title] - Заголовок карточки (не выводится, если пуст).
  @param {string} [text] - Основной текст (не выводится, если пуст).
  @param {string} [class] - Дополнительный CSS-класс для .card.
#}
{% macro card(title, text, class) %}
  <div class="card{% if class %} {{ class }}{% endif %}">
    {% if title %}<h3 class="card__title">{{ title }}</h3>{% endif %}
    {% if text %}<p class="card__text">{{ text }}</p>{% endif %}
    {% if caller %}<div class="card__footer">{{ caller() }}</div>{% endif %}
  </div>
{% endmacro %}

{#
  Макрос для создания "ловушки для ботов" (Honeypot).
  Создает поле, невидимое для людей, но видимое для ботов.
#}
{% macro honeypot(name='bot-field') %}
  <div style="position: absolute; left: -5000px;" aria-hidden="true">
    <input type="text" name="{{ name }}" tabindex="-1" value="">
  </div>
{% endmacro %}

{#
  Макрос для скрытого поля ввода (например, служебный номер формы).
  @param {string} name - Атрибут name (также используется как id).
  @param {string} [value] - Значение по умолчанию.
#}
{% macro hiddenInput(name, value='') %}
  <input type="hidden" id="{{ name }}" name="{{ name }}" value="{{ value }}">
{% endmacro %}

{#
  УМНЫЙ МАКРОС INPUT
  Генерирует поле ввода. Приоритет отдается переданным параметрам.
  Если type='tel' и placeholder не указан, используется значение по умолчанию.
  Классы по умолчанию — из UI-кита (components/_fields.scss); для особых форм
  (например, формы заявки) классы переопределяются параметрами.
#}
{% macro input(name, label, type='text', className='input', wrapperClass='field', labelClass='field__label', placeholder, required=false, pattern, autocomplete) -%}
  {#
    Логика с приоритетом:
    1. Сначала берем `placeholder`, который передал пользователь.
    2. Если он НЕ был передан (is none), И тип поля 'tel', ТОЛЬКО ТОГДА используем наш дефолт.
  #}
  {% set final_placeholder = placeholder if placeholder is not none else 
    ("|+375..." if type == 'tel') %}
  {% set final_pattern = pattern if pattern is not none else ("\\s*\\+375\\s?\\(?(1[567]|2[12359]|33|44)\\)?\\s?\\d{3}-\\d{2}-\\d{2}" if type == 'tel') %}
  {% set final_autocomplete = autocomplete if autocomplete is not none else 
    ("tel" if type == 'tel') %}

  {# Генерируем HTML для самого <input> #}
  {% set input_html %}
  <input type="{{ type }}" id="{{ name }}" name="{{ name }}" class="{{ className }}"{% if final_placeholder %} placeholder="{{ final_placeholder }}"{% endif %}{% if required %} required="required"{% endif %}{% if final_pattern %} pattern="{{ final_pattern }}"{% endif %}{% if final_autocomplete %} autocomplete="{{ final_autocomplete }}"{% endif %}>
  {% endset %}

  {# Если передан `label`, оборачиваем инпут #}
  {% if label %}
    <div class="{{ wrapperClass }}">
      <label for="{{ name }}" class="{{ labelClass }}">{{ label }}</label>
      {{- input_html | safe -}}
    </div>
  {% else %}
    {# Иначе выводим "голый" инпут #}
    {{- input_html | safe -}}
  {% endif %}
{%- endmacro %}

{#
  ----------------------------------------------------------------------------------------------------
  КАК ТЕПЕРЬ ИСПОЛЬЗОВАТЬ:
  ----------------------------------------------------------------------------------------------------

  1. Импортируем файл:
    {% import "../macros/_ui.njk" as ui %}

  2. Телефон БЕЗ лейбла (как в нашей форме):
    {{ ui.input(name='phone', type='tel', className='form__phone-field') }}

  3. Телефон С лейблом (для другого места на сайте):
    {{ ui.input(
        name='contact-phone',
        type='tel',
        label='Ваш номер телефона',
        className='another-form__input'
    ) }}

  4. Телефон С ДЕФОЛТНЫМ ПЛЕЙСХОЛДЕРОМ (как в нашей форме):
    {{ ui.input(name='phone', type='tel', className='form__phone-field') }}
    (Результат: placeholder="|+375...")

  5. Телефон С КАСТОМНЫМ ПЛЕЙСХОЛДЕРОМ (если понадобится в другом месте):
  {{ ui.input(
        name='phone',
        type='tel',
        className='form__phone-field',
        placeholder='Ваш мобильный'
    ) }}

  6. Обычное текстовое поле (работает как и раньше):
  {{ ui.input(name='user-name', label='Ваше имя', className='form__input') }}
----------------------------------------------------------------------------------------------------
#}