{#
  ====================================================================================================
  _docs.njk — макросы «оправы» страницы-документации (styleguide.njk).
  ====================================================================================================

  Не путать с _ui.njk: там — компоненты сайта (кнопки, поля, карточки),
  здесь — обертки самой документации (секция с заголовком и описанием).

  Использование:

    {% import "macros/_docs.njk" as docs %}

    {% call docs.section(id='buttons', title='Кнопки', descr='Краткое пояснение...') %}
      ...живой пример + <pre class="sg-code">...
    {% endcall %}
#}

{#
  Секция документации: якорный id, заголовок, краткое пояснение.
  Весь контент (демо, код) передается блоком {% call %}.

  @param {string} id - Якорь секции (совпадает с id в навигации styleguide).
  @param {string} title - Заголовок секции (h2).
  @param {string} [descr] - Краткое пояснение, когда и зачем применять компонент.
#}
{% macro section(id, title, descr) %}
<section class="sg-section" id="{{ id }}">
  <header class="sg-section__head">
    <h2 class="sg-section__title">{{ title }}</h2>
    {% if descr %}<p class="sg-section__descr">{{ descr }}</p>{% endif %}
  </header>
  {% if caller %}{{ caller() }}{% endif %}
</section>
{% endmacro %}
