{#
====================================================================================================
_default.njk (v4.0 - На основе вашего кода)
====================================================================================================

Главный макет-обертка для СТАТИЧЕСКОЙ разработки.

Dev-клиент Vite (@vite/client) и трансформация модулей подключаются
АВТОМАТИЧЕСКИ (server.transformIndexHtml в vite-plugin-njk-frontmatter),
поэтому никакие хардкод-скрипты с портом 5173 в шаблоне не нужны.

----------------------------------------------------------------------------------------------------
ШПАРГАЛКА ПО NUNJUCKS
----------------------------------------------------------------------------------------------------
{% extends "./path/to/layout.njk" %}     -- Наследование макета (должно быть первой строкой)
{% block content %}{% endblock %}        -- Определение блока для вставки контента
{% include "../path/to/partial.njk" %}   -- Вставка другого шаблона (партиала)
{{ variable }}                           -- Вывод переменной
{# Это комментарий --}                  -- Пример комментария Nunjucks
{% set myVar = "значение" %}             -- Установка переменной
{% if user.loggedIn %}{% endif %}        -- Условные операторы
{% for item in items %}{% endfor %}      -- Циклы
{{ macro.myMacro(arg1, arg2) }}          -- Вызов макроса
{{ site.url }}                           -- Доступ к глобальным данным из data/site.json
====================================================================================================
#}

<!DOCTYPE html>
<html lang="ru">
  <head>
    {# ... существующие мета-теги (charset, viewport, title, description) ... #}
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ title or site.title or 'Заголовок по умолчанию' }}</title>
    <meta name="description" content="{{ description or site.description or 'Описание по умолчанию' }}">
    <meta name="keywords" content="{{ keywords or site.keywords or '' }}">

    {#
      Фавикон-теги (<link rel="icon|apple-touch-icon|manifest">, theme-color)
      в продакшн-HTML инжектит плагин vite-html-asset-inject (см. vite.config.js) —
      в шаблоне их не дублируем. Для dev-режима оставляем ссылку на перенесённый
      из legacy/src/img/favicons/ фавикон (в продакшне она НЕ попадает в HTML
      благодаря site.production, а vite-html-asset-inject перепишет /src/... путь
      на собранный ассет при необходимости).
    #}
    {% if not site.production %}
      <link rel="icon" href="/src/assets/images/favicons/favicon.svg" type="image/svg+xml">
    {% endif %}

    {# ПОДКЛЮЧАЕМ МЕТА-ТЕГИ ДЛЯ СОЦСЕТЕЙ #}
    {% block social_meta %}
      {% include "../partials/_meta-social.njk" %}
    {% endblock %}

    {#
      Dev-скрипты Vite (HMR-клиент и трансформация модулей) инжектятся
      автоматически через server.transformIndexHtml. В продакшн-HTML этот
      тег заменяется на собранный чанк плагином vite-html-asset-inject
      (см. vite.config.js).
    #}
    <script type="module" src="/src/js/app.js"></script>

    {% block head %}{% endblock %}
  </head>
  <body class="{% if body_class %}{{ body_class }}{% else %}page__body{% endif %}">

    {# SVG-символы (vite-plugin-svg-sprite) инжектятся в DOM из app.js;
       пустой <svg> из partials/_sprite-inline.njk в legacy-разметке отсутствовал
       (спрайт был закомментирован) — include убран как фантомный элемент. #}

    {# Класс .out — обёртка из legacy-макета: на ней висит фон всего сайта
       (bg-all.svg, см. scss/legacy/_common.sass). #}
    <div class="out">
      {% block content %}{% endblock %}
    </div>

    {% block counters %}
      {# ПОДКЛЮЧАЕМ СЧЕТЧИКИ #}
      {% include "../partials/_counters.njk" %}
    {% endblock %}

  </body>
</html>