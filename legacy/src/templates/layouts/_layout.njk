{% import "partials/_mixins.njk" as mixins %}
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>
      {% if title %}{{ title }}
      {% else %}Template{% endif %}
    </title>
    <meta name="keywords" content="{% if keywords %}{{ keywords }}{% else %}{% endif %}"/>
    <meta name="description" content="{% if description %}{{ description }}{% else %}{% endif %}"/>
    <meta name="robots" content="{% if robots %}{{ robots }}{% else %}{% endif %}"/>
    <meta http-equiv="X-UA-Compatible" content="IE=Edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="{% if theme_color %}{{ theme_color }}{% else %}#fff{% endif %}"/>
    <meta name="SKYPE_TOOLBAR" content="SKYPE_TOOLBAR_PARSER_COMPATIBLE"/>
    <meta name="format-detection" content="telephone=no"/>
    <meta http-equiv="x-rim-auto-match" content="none"/>
    <link rel="stylesheet" media="all" href="css/app.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300&family=Oswald&display=swap" rel="stylesheet">
    <!--<link rel="icon" type="image/svg+xml" href="img/favicon/favicon.svg">-->

    {# {% include "../partials/_meta-tags.njk" %} #}
  </head>
  <body class="{% if body_class %}{{ body_class }}{% else %}{% endif %}">

    <!-- BEGIN content -->
    <div class="{% if out_class %}{{ out_class }}{% else %}out{% endif %}">
      {% block content %}{% endblock %}
    </div>
    <!-- END content -->
    <div class="overlay">
      <div class="container">
        <div class="layout">
          <div class="modal">
            <div class="modal__close">&times;</div>
            <div class="modal__title title">Спасибо</div>
            <div class="modal__descr">Наши менеджеры свяжутся с вами через несколько минут</div>
          </div>
        </div>
      </div>
    </div>
    <!-- BEGIN scripts -->
    <script src="js/app.js"></script>
    <!-- END scripts -->
    <!-- BEGIN counters -->
    <!-- Google tag (gtag.js) -->
