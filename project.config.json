{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "projectName": "vite-bridge-boilerplate",
  "version": "0.0.11",
  "themeSlug": "my-theme",
  "pwa": true,
  "compression": {
    "tinypng": {
      "enabled": true,
      "sourceDir": "frontend/src/assets/images",
      "outputDir": "frontend/src/assets/images-tiny",
      "cacheFile": "temp/.tinypng-cache",
      "envVar": "TINYPNG_API_KEYS"
    },
    "imageConvert": {
      "enabled": true,
      "cacheFile": ".convert-images-cache.json"
    }
  },
  "targets": {
    "static": {
      "description": "Static site build — full image optimization with WebP + AVIF",
      "imageProcessing": {
        "webp": true,
        "avif": true,
        "quality": {
          "webp": 80,
          "avif": 75
        }
      }
    },
    "cms": {
      "description": "CMS/WordPress build — WebP only, AVIF disabled for lightweight builds and hosting safety",
      "imageProcessing": {
        "webp": true,
        "avif": false,
        "quality": {
          "webp": 80,
          "avif": 75
        }
      }
    }
  },
  "defaults": {
    "target": "static",
    "frontendSourceDir": "frontend/src"
  }
}