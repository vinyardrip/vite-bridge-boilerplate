{
  "name": "vite-bridge-boilerplate",
  "version": "0.5.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "dev": "vite",
    "full": "concurrently -n \"VITE,DDEV\" -c \"blue,green\" \"pnpm dev\" \"echo 'Start DDEV manually'\"",
    "build": "node scripts/compress-images.js && node scripts/optimize-svg.js && vite build",
    "build:wp": "node scripts/compress-images.js && node scripts/optimize-svg.js && vite build --mode wordpress",
    "build:stats": "ANALYZE=true pnpm build",
    "build:wp-strip-avif": "node scripts/strip-avif.js",
    "preview": "vite preview",
    "format:code": "biome format --write ./frontend/src",
    "format:templates": "prettier --write \"./frontend/src/views/**/*.njk\"",
    "format": "pnpm format:code && pnpm format:templates",
    "lint:code": "biome lint --write ./frontend/src",
    "check": "pnpm lint:code && pnpm format",
    "verify": "pnpm build && pnpm test:build && pnpm playwright test",
    "test:ui": "pnpm playwright test --ui",
    "test:build": "node scripts/check-build.js",
    "test:wp": "node scripts/test-wp-helpers.js",
    "test:update": "pnpm build && pnpm playwright test --update-snapshots",
    "/*! --- ДИАГНОСТИЧЕСКИЕ ИНСТРУМЕНТЫ --- */": "",
    "test:fonts": "vite --open /pages/test-fonts.html",
    "sync:theme": "if [ -n \"$(git status --porcelain)\" ]; then echo '❌ Ошибка: Обнаружены незакоммиченные изменения!'; exit 1; fi && echo '✅ Рабочая директория чиста, начинаю синхронизацию...' && rsync -av --delete dist/ backend/wp-content/themes/my-theme/assets/",
    "/*! --- ВСПОМОГАТЕЛЬНЫЕ (UTILITY) СКРИПТЫ --- */": "",
    "favicons:generate": "pwa-assets-generator --config vite.config.js",
    "images:convert": "node scripts/convert-images.js",
    "images:compress": "node scripts/compress-images.js",
    "svg:optimize": "node scripts/optimize-svg.js",
    "test": "pnpm --filter vite-plugin-smart-assets test"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@atrocityz/vite-plugin-html-img-to-picture": "^1.0.8",
    "@biomejs/biome": "^2.3.2",
    "@playwright/test": "^1.56.1",
    "@vituum/vite-plugin-nunjucks": "^1.1.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.11.13",
    "chalk": "^5.6.2",
    "concurrently": "^10.0.7",
    "critical": "^7.2.1",
    "debug-css-overflow": "^1.1.1",
    "dotenv": "^17.2.3",
    "fontaine": "^0.6.0",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "ora": "^9.0.0",
    "postcss-sort-media-queries": "^5.2.0",
    "posthtml": "^0.16.7",
    "posthtml-responsive-images": "^1.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-jinja-template": "^2.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass-embedded": "^1.100.0",
    "sharp": "^0.34.4",
    "svgo": "^4.0.0",
    "tinify": "^1.8.2",
    "vite": "^7.1.12",
    "vite-imagetools": "^12.0.0",
    "vite-njk-trace": "^1.0.1",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-image-optimize": "^2.0.1",
    "vite-plugin-njk-frontmatter": "^1.0.2",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-smart-assets": "workspace:*",
    "vite-plugin-svg-sprite": "^0.6.3",
    "vite-plugin-webfont-dl": "^3.11.1",
    "vituum": "^2.0.2"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "inputmask": "^5.0.9",
    "swiper": "^12.0.3"
  }
}
